# Poul Scripts — Environment Variables
# Copy this file to .env (one level up, at the repo root) and fill in your keys.

# Notion Integration Token
# Create at: https://www.notion.so/my-integrations
# Grant access to the "Poul Card Database" page after creating it.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (for generate-city.js)
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
